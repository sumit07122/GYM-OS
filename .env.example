# ==============================================================================
# GymOS Multi-Tenant Gym Management ERP SaaS — Environment Configuration
# ==============================================================================

# Supabase Project Connection (Recommended Region: ap-south-1 Mumbai)
# Replace with your dedicated Supabase project URL and public Anon key:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Environment ('production' | 'staging' | 'development')
VITE_APP_ENV=production

# Server & Client Timezone Defaults
VITE_APP_TIMEZONE=Asia/Kolkata
VITE_DEFAULT_CURRENCY=INR
