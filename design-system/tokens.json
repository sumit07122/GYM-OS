{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "GymOS Design Tokens",
  "version": "1.0.0",
  "tokens": {
    "colors": {
      "background": {
        "base": "#090D16",
        "surface": "#111827",
        "elevated": "#1E293B",
        "overlay": "rgba(9, 13, 22, 0.85)"
      },
      "border": {
        "subtle": "rgba(255, 255, 255, 0.08)",
        "default": "#334155",
        "active": "#10B981"
      },
      "text": {
        "primary": "#F8FAFC",
        "secondary": "#94A3B8",
        "muted": "#64748B",
        "inverse": "#090D16"
      },
      "brand": {
        "primary": "#10B981",
        "primaryHover": "#059669",
        "accent": "#34D399",
        "subtle": "rgba(16, 185, 129, 0.12)"
      },
      "semantic": {
        "success": {
          "base": "#10B981",
          "surface": "rgba(16, 185, 129, 0.15)",
          "border": "rgba(16, 185, 129, 0.3)"
        },
        "warning": {
          "base": "#F59E0B",
          "surface": "rgba(245, 158, 11, 0.15)",
          "border": "rgba(245, 158, 11, 0.3)"
        },
        "danger": {
          "base": "#EF4444",
          "surface": "rgba(239, 68, 68, 0.15)",
          "border": "rgba(239, 68, 68, 0.3)"
        },
        "info": {
          "base": "#3B82F6",
          "surface": "rgba(59, 130, 246, 0.15)",
          "border": "rgba(59, 130, 246, 0.3)"
        }
      }
    },
    "typography": {
      "fontFamily": {
        "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
      },
      "fontSize": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem"
      },
      "fontWeight": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800
      }
    },
    "spacing": {
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem"
    },
    "radius": {
      "sm": "0.25rem",
      "md": "0.375rem",
      "lg": "0.5rem",
      "xl": "0.75rem",
      "full": "9999px"
    },
    "shadows": {
      "card": "0 1px 3px 0 rgba(0, 0, 0, 0.4), 0 1px 2px -1px rgba(0, 0, 0, 0.4)",
      "dropdown": "0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -4px rgba(0, 0, 0, 0.5)",
      "glow": "0 0 15px -3px rgba(16, 185, 129, 0.25)"
    },
    "transitions": {
      "fast": "150ms cubic-bezier(0.4, 0, 0.2, 1)",
      "normal": "200ms cubic-bezier(0.4, 0, 0.2, 1)",
      "slow": "300ms cubic-bezier(0.4, 0, 0.2, 1)"
    }
  }
}